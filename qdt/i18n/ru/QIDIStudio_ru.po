msgid "Cost %dg filament and %d changes more than optimal grouping."
msgstr "Потребуется на %d г филамента и на %d смен больше, чем при оптимальной группировке."

msgid "both extruders"
msgstr "оба экструдера"

#, c-format, boost-format
msgid "[ %s ] requires printing in a high-temperature environment. Reminder to close the door if not already closed."
msgstr "[ %s ] требует печати в условиях высокой температуры. Если дверца ещё не закрыта, закройте её."

#, c-format, boost-format
msgid "[ %s ] requires printing in a high-temperature environment."
msgstr "[ %s ] требует печати в условиях высокой температуры."

#, c-format, boost-format
msgid "The filament on %s may soften. Please unload."
msgstr "Филамент в %s может размягчиться. Выгрузите его."

#, c-format, boost-format
msgid "The filament on %s is unknown and may soften. Please set filament."
msgstr "Филамент в %s неизвестен и может размягчиться. Укажите филамент."

msgid ""
"Upper half area:  Original\n"
"Middle  area:  Filament in BOX\n"
"Lower half area:  Selected nozzle\n"
"And you can click it to modify"
msgstr ""
"Верхняя половина: исходное\n"
"Средняя область: филамент в Box\n"
"Нижняя половина: выбранное сопло\n"
"Нажмите, чтобы изменить"

msgid ""
"Upper half area:  Original\n"
"Lower half area:  Filament in BOX\n"
"And you can click it to modify"
msgstr ""
"Верхняя половина: оригинал\n"
"Нижняя половина: филамент в Box\n"
"Можно изменить при нажатии."

msgid "Unable to automatically match to suitable filament. Please click to manually match."
msgstr "Не удалось автоматически подобрать подходящий филамент. Нажмите, чтобы подобрать вручную."

msgid "Install toolhead enhanced cooling fan to prevent filament softening."
msgstr "Установите усиленный вентилятор охлаждения печатающей головки, чтобы филамент не размягчался."

#, c-format, boost-format
